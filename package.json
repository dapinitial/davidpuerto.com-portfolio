{
  "name": "davidpuerto.com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "PORT=3001 node --env-file=.env server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && NODE_ENV=production PORT=3001 node --env-file=.env server/index.js",
    "lock": "npm run build && node --env-file=.env scripts/lock-content.mjs",
    "test": "node --env-file-if-exists=.env --test tests/server.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:ga": "node --env-file=.env tests/ga-health.mjs",
    "admin:password": "node tools/set-admin-password.mjs",
    "visits:connect": "node tools/connect-visits.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.1",
    "gsap": "^3.13.0",
    "nodemailer": "^10.1.2",
    "three": "^0.170.0",
    "vite": "^7.0.6"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
