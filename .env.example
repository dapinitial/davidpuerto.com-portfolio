# Copy to .env and fill in. NEVER commit .env.
COOKIE_SECRET=          # openssl rand -base64 32
PASSWORD_HASH=          # bcrypt hash of the case-studies password
GMAIL_USER=             # Gmail address that sends contact-form mail
GMAIL_APP_PASSWORD=     # Google Account -> Security -> 2-Step Verification -> App passwords
CONTACT_TO=me@davidpuerto.com

# Analytics (/admin dashboard) — all optional; /api/admin/stats answers 503 until set.
# The GA measurement id (G-XXXX) is NOT an env var — it lives in the
# <meta name="ga-id"> tag in each page head.
GA_PROPERTY_ID=         # numeric GA4 property id (Admin -> Property details)
GA_CLIENT_EMAIL=        # service account email (...@...iam.gserviceaccount.com)
GA_PRIVATE_KEY=         # service account PEM private key; literal \n is fine
CONTENT_KEY=          # openssl rand -base64 32 — decrypts content-locked/ (NDA case studies)
